# Copie para .env. Este arquivo NUNCA vai para o git nem para o chat.
# Chave da ElevenLabs com permissão só de leitura (Perfil > API Keys)
ELEVENLABS_API_KEY=
# Telegram (Fase 2): crie o bot no @BotFather (/newbot), cole o token e rode `npm run telegram:parear`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Supabase (Fase 2, painel /central do site). A service_role fica SÓ aqui no PC, nunca no site nem no git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública (anon) e endereço do site: usadas por `npm run site:sync` para gerar public/central/config.js
SUPABASE_ANON_KEY=
# Porta do painel (padrão 4321)
EDH_PORT=4321
# Caminhos, se não forem os padrões (ex.: Claude Code dentro do WSL acessado pelo Windows)
# CLAUDE_HOME=\\wsl$\Ubuntu\home\eduardo\.claude
# CODEX_HOME=C:\Users\Eduardo\.codex
