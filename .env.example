# Meta Ads — preencher na Vercel (Settings > Environment Variables), nao aqui.
# Sem estas variaveis o site roda igual: o pixel simplesmente nao carrega.

# Dataset ID do Meta (Gerenciador de Eventos > Fontes de dados). 15-16 digitos.
NEXT_PUBLIC_META_PIXEL_ID=

# Token de verificacao de dominio (Configuracoes do negocio > Dominios).
# Usar a opcao "Meta-tag": copiar so o valor do content="".
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
